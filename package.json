{
  "name": "scrolloop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "verify": "turbo run typecheck test",
    "e2e:ui": "yarn workspace @scrolloop/e2e-ui test"
  },
  "devDependencies": {
    "@types/cache-manager": "^5.0.0",
    "@types/cron": "^2.4.3",
    "@types/ioredis": "^5.0.0",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-microsoft": "^2.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/schedule": "^6.1.0",
    "@types/geoip-lite": "^1.4.4",
    "argon2": "^0.44.0",
    "cache-manager": "^7.2.7",
    "cron": "^4.4.0",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "next": "^16.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "speakeasy": "^2.0.0",
    "tsup": "^8.5.1",
    "typeorm": "^0.3.28",
    "ua-parser-js": "^2.0.7"
  }
}
