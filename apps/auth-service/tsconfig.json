{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": false,

    "paths": {
      "@/*": ["./src/*"],
      "@fortknox/sdk": ["../../packages/fortknox-sdk/src/index.ts"],
      "@fortknox/types": ["../../packages/fortknox-types/src/index.ts"],
      "@repo/database": ["../../packages/database/index.ts"],
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@repo/security": ["../../packages/security/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
}
