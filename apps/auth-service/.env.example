# Application
NODE_ENV=development
PORT=4000

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost           # For dev: localhost, For prod: yourdomain.com
WEBAUTHN_ORIGIN=http://localhost:3000  # For dev, For prod: https://yourdomain.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=scrolloop_sentry

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# ================================
# EMAIL CONFIGURATION
# ================================
# The email provider is auto-detected based on which credentials are set:
# 1. If AWS_SES_ACCESS_KEY_ID and AWS_SES_SECRET_ACCESS_KEY are set → use AWS SES
# 2. Else if SMTP_HOST is set → use SMTP (NodeMailer)
# 3. Else → log to console (development mode)

# Option 1: SMTP (NodeMailer) - For Gmail, Outlook, custom SMTP servers
# Uncomment these to use SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Option 2: AWS SES (Recommended for Production)
# Uncomment these to use AWS SES:
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=AKIA...
# AWS_SES_SECRET_ACCESS_KEY=...

# Email Settings (Common to all providers)
EMAIL_FROM=noreply@sentry.scrolloop.com
EMAIL_FROM_NAME=Scrolloop Sentry
EMAIL_REPLY_TO=support@sentry.scrolloop.com

# ================================
# NOTES FOR EMAIL SETUP
# ================================
# Gmail SMTP:
#   - Use App Password, not your regular password
#   - Enable 2FA and generate app password at: https://myaccount.google.com/apppasswords
#   - SMTP_HOST=smtp.gmail.com
#   - SMTP_PORT=587
#   - SMTP_SECURE=false
#
# AWS SES:
#   - Verify sender email/domain in AWS SES console
#   - Create IAM user with SES sending permissions
#   - Use separate credentials from main AWS account (security best practice)
#   - Start in SES Sandbox mode, request production access for full functionality
#
# Development Mode:
#   - Leave all email credentials blank to log emails to console
#   - Useful for local testing without configuring email providers
