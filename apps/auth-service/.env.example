# ════════════════════════════════════════════════════════════════════════
#  Scrolloop Sentry — auth-service environment
#
#  cp .env.example .env    then fill in the four secrets below.
#  The contract lives in src/config/env.validation.ts — the service refuses
#  to boot if a required value is missing. Keep this file in sync with it.
#
#  Generate secrets:
#    JWT_SECRET            openssl rand -hex 32
#    SESSION_SECRET        openssl rand -hex 32
#    KEYRING_MASTER_KEY    openssl rand -base64 32
#    TOKEN_ENCRYPTION_KEY  openssl rand -hex 32
# ════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Hops/subnets to trust for X-Forwarded-For. REQUIRED behind a load balancer,
# otherwise every client shares one rate-limit bucket. e.g. 1 or "loopback, 10.0.0.0/8"
# TRUST_PROXY=1

# ── Public URLs ─────────────────────────────────────────────────────────
ISSUER_BASE_URL=http://localhost:4000      # externally reachable URL of this service
FRONTEND_URL=http://localhost:3000         # used in email links
PORTAL_URL=http://localhost:3000
INTERNAL_PORTAL_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:4000
PUBLIC_BASE_URL=http://localhost:4000      # base for uploaded asset URLs
# ADMIN_PORTAL_ORIGIN=https://sentry.scrolloop.com   # allowed during first-run bootstrap
CORS_ORIGINS=http://localhost:3000         # comma-separated static allow-list

# ── Platform & tenancy ──────────────────────────────────────────────────
SENTRY_PLATFORM_NAME=Scrolloop Sentry
SENTRY_PLATFORM_SLUG=sentry
# Base domain for subdomain tenancy: acme.<domain> → tenant "acme". Unset locally.
# SENTRY_PLATFORM_DOMAIN=sentry.scrolloop.com
# Accept X-Tenant-ID in production (always accepted in development).
ALLOW_TENANT_ID_HEADER=false
# Share auth cookies across tenant subdomains in production.
# COOKIE_DOMAIN=.sentry.scrolloop.com

# ── Tokens & keys (REQUIRED) ────────────────────────────────────────────
JWT_ISSUER=http://localhost:4000           # `iss` claim; MUST match discovery issuer
JWT_SECRET=
KEYRING_MASTER_KEY=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=                      # required when NODE_ENV=production
SESSION_TTL=604800                         # seconds (7 days)

# ── Database ────────────────────────────────────────────────────────────
DB_URL=postgresql://postgres:postgres@localhost:5432/scrolloop_sentry
DB_SSL=false
# Verify the server certificate (recommended in production):
# DB_SSL_CA=<PEM or base64-encoded PEM>
# DB_SSL_REJECT_UNAUTHORIZED=true
DB_LOGGING=false
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=sentry

# ── Rate limiting ───────────────────────────────────────────────────────
# DANGER: development only; ignored unless NODE_ENV=development.
DISABLE_RATE_LIMIT=false

# ── WebAuthn / passkeys ─────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Email — provider auto-detected: SES > SMTP > console (dev) ──────────
EMAIL_FROM=noreply@sentry.scrolloop.com
EMAIL_FROM_NAME=Scrolloop Sentry
EMAIL_REPLY_TO=support@sentry.scrolloop.com
# SUPPORT_EMAIL=support@sentry.scrolloop.com
# SMTP (docker-compose ships Mailpit on :1025, UI on http://localhost:8025)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=

# ── Social login for the platform portal (optional) ─────────────────────
# INTERNAL_GOOGLE_CLIENT_ID=
# INTERNAL_GOOGLE_CLIENT_SECRET=
# INTERNAL_GOOGLE_CALLBACK_URL=http://localhost:4000/auth/social/google/callback
# INTERNAL_GITHUB_CLIENT_ID=
# INTERNAL_GITHUB_CLIENT_SECRET=
# INTERNAL_GITHUB_CALLBACK_URL=http://localhost:4000/auth/social/github/callback
# INTERNAL_MICROSOFT_CLIENT_ID=
# INTERNAL_MICROSOFT_CLIENT_SECRET=
# INTERNAL_MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/social/microsoft/callback

# ── File storage ────────────────────────────────────────────────────────
# UPLOAD_DIR=./uploads

# ── First-run & seeding (never set in production) ───────────────────────
# Prefer the /setup wizard. These create a superadmin non-interactively (CI).
# SEED_SUPERADMIN_EMAIL=admin@example.com
# SEED_SUPERADMIN_PASSWORD=
# Seed the demo "Example Third-Party App" OAuth client.
SEED_EXAMPLE_CLIENTS=false
# SENTRY_SETUP_LOG_DIR=~/.sentry
