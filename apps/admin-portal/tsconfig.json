{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@fortknox/sdk": ["../../packages/fortknox-sdk/src/index.ts"],
      "@fortknox/sdk/*": ["../../packages/fortknox-sdk/src/*"],
      "@fortknox/types": ["../../packages/fortknox-types/src/index.ts"],
      "@repo/ui": ["../../packages/ui/src/index.ts"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/shared": ["../../packages/shared/src/index.ts"],
      "@repo/database": ["../../packages/database/src/index.ts"],
      "@repo/security": ["../../packages/security/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
}
