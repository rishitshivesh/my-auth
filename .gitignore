# ── Dependencies ────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Environment (never commit real secrets) ─────────────────────
.env
.env.*
!.env.example

# ── Build output ────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts
packages/*/*.js
packages/*/*.js.map
packages/*/*.d.ts
packages/*/*.d.ts.map
!packages/eslint-config/*.js
!packages/ui/*.js

# ── Generated at runtime ────────────────────────────────────────
apps/auth-service/api-management/
apps/auth-service/uploads/
graphify-out/

# ── Test & coverage ─────────────────────────────────────────────
coverage/
*.lcov

# ── Logs & debug ────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
app-logs*.txt

# ── Ad-hoc code dumps (never commit) ────────────────────────────
consolidated-code*.txt

# ── Keys & certificates ─────────────────────────────────────────
*.pem
*.key
*.p12

# ── Editors & OS ────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ── Deployment tooling ──────────────────────────────────────────
.vercel/
venv/

# ── Local service data ──────────────────────────────────────────
dump.rdb
apps/docs/.source/
