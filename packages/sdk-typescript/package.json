{
  "name": "@scrolloop/sdk",
  "version": "1.0.1",
  "description": "Scrolloop Sentry Authentication SDK - Session runtime for multi-tenant auth",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./dist/core/index.js"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "import": "./src/web/index.ts",
      "default": "./dist/web/index.js"
    },
    "./react": {
      "types": "./src/react/index.tsx",
      "import": "./src/react/index.tsx",
      "default": "./dist/react/index.js"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "import": "./src/next/index.ts",
      "default": "./dist/next/index.js"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "import": "./src/node/index.ts",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "jwt",
    "multi-tenant",
    "session",
    "sentry"
  ],
  "author": "Scrolloop Sentry",
  "license": "MIT",
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@scrolloop/types": "*"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
